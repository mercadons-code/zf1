{
    "name": "mercadons/zf1",
    "description": "Maintained fork of Zend Framework 1 for modern PHP (7.4 – 8.4).",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "https://github.com/mercadons-code/zf1",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/mercadons-code/zf1/issues",
        "source": "https://github.com/mercadons-code/zf1"
    },
    "require": {
        "php": ">=7.4 <8.5"
    },
    "replace": {
        "jdrumsmns/zf1_php7": "*",
        "zendframework/zendframework1": "*"
    },
    "autoload": {
        "psr-0": {
            "Zend_": "zendframework1/library/"
        }
    },
    "include-path": [
        "zendframework1/library/"
    ],
    "config": {
        "bin-dir": "bin"
    },
    "archive": {
        "exclude": ["/demos", "/documentation", "/tests"]
    }
}
